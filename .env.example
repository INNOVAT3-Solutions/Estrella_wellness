# Copy to .env.local (never commit .env.local) and fill in.

# Inbound webhook URL from your CRM / booking system. Booking requests
# (name, phone, email, location, preferred date and time, consent) are
# POSTed here as JSON. Required in production: without it the form shows
# a "call or email us" message instead of submitting.
BOOKING_WEBHOOK_URL=

# Optional shared secret, sent as "Authorization: Bearer <secret>".
BOOKING_WEBHOOK_SECRET=

# Stripe Payment Link for the $199.99/month program (public URL, safe to
# expose). In Stripe, set the link's "after payment" redirect to:
#   https://<your-domain>/qualify/confirmed?paid=1
# Leave empty to hide online payment (patients can still pay at the visit).
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

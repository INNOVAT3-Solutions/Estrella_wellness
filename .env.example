# Copy to .env.local (never commit .env.local) and fill in.
# On Vercel, add the same names under Project > Settings > Environment Variables.

# --- GoHighLevel (server only) ---------------------------------------------
# Private Integration token for the Estrella sub-account (starts with pit-).
# Scopes: contacts (view/edit), tags, custom fields, opportunities (view/edit),
# locations (view), calendars (view, events view/edit).
GHL_PRIVATE_TOKEN=
# Sub-account Location ID (Settings > Business Profile).
GHL_LOCATION_ID=
# "GLP-1 Weight Loss" pipeline and its NEW and Paid stages.
GHL_PIPELINE_ID=
GHL_STAGE_NEW_ID=
GHL_STAGE_PAID_ID=

# --- Stripe ----------------------------------------------------------------
# Payment Link for the $199.99/month program (public URL, safe to expose).
# In Stripe, set the link's "after payment" redirect to:
#   https://<your-domain>/qualify/confirmed?paid=1
# Leave empty to hide online payment (patients can still pay at the visit).
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=
# Signing secret of the webhook endpoint https://<your-domain>/api/stripe/webhook
# listening for checkout.session.completed (starts with whsec_).
STRIPE_WEBHOOK_SECRET=
